+   if (!may_wait) {
+      if (!slock_try_lock(acdrom.buf_lock))
+         return 0;
+   }
+   else
+#endif
    slock_lock(acdrom.buf_lock);
    if ((lba | cdda_bit) == acdrom.buf_cache[i].lba_wflag) {
       if (buf)
