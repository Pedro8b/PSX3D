-static int lbacache_get(unsigned int lba, void *buf, void *sub_buf, int is_cdda)
+static int lbacache_get_(unsigned int lba, void *buf, void *sub_buf, int is_cdda, int may_wait)
 {
    u32 i, cdda_bit = is_cdda ? (1u << 31) : 0;
    int ret = 0;
 
    i = lba % acdrom.buf_cnt;
+#ifdef _3DS
+   // PSX3D: on Old 3DS the prefetch thread lives on the syscore, which only
+   // runs it in time slices. If it got stopped holding the lock, don't wait
