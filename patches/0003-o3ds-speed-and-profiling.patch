+// 0 fill, 1 polygon, 2 textured polygon, 3 textured polygon semi-transparent,
+// 4 line, 5 rectangle, 6 sprite, 7 sprite semi-transparent, 8 other
+static int psx3d_gcls(u32 cmd)
+{
+  if (cmd == 0x02) return 0;
+  if (cmd >= 0x20 && cmd < 0x40) return !(cmd & 4) ? 1 : (cmd & 2) ? 3 : 2;
+  if (cmd >= 0x40 && cmd < 0x60) return 4;
+  if (cmd >= 0x60 && cmd < 0x80) return !(cmd & 4) ? 5 : (cmd & 2) ? 7 : 6;
+  return 8;
+}
