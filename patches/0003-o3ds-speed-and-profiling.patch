+// PSX3D profiler: time spent in each kind of event, and where the PS1 CPU
+// was when events came due (a cheap time-sampled view of guest code: a
+// game spinning in a loop shows up as one address taking a big share)
+unsigned long long psx3d_irq_t[PSXINT_COUNT];
+unsigned int psx3d_irq_c[PSXINT_COUNT];
+#define PSX3D_PCS 64
+unsigned int psx3d_pcs_pc[PSX3D_PCS], psx3d_pcs_n[PSX3D_PCS], psx3d_pcs_total;
+
+static void psx3d_pc_sample(u32 pc)
+{
+	u32 h = (pc >> 2) * 2654435761u >> 26, k;
+	psx3d_pcs_total++;
+	for (k = 0; k < 8; k++, h = (h + 1) & (PSX3D_PCS - 1)) {
+		if (psx3d_pcs_n[h] == 0)
+			psx3d_pcs_pc[h] = pc;
+		if (psx3d_pcs_pc[h] == pc) {
+			psx3d_pcs_n[h]++;
+			return;
+		}
+	}
+}
