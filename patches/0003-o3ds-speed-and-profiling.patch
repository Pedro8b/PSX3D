+// PSX3D: idle loop detection.
+// A short backward branch whose loop body only reads memory and computes on
+// what it read (no stores, no calls, nothing carried over from the previous
+// time round) does the same thing every time until something else changes
+// memory or time passes (interrupt, DMA, timer, CD, GPU done). So each
+// time round is charged a big chunk of emulated time: the wait ends after
+// far fewer host iterations, overshooting it by at most that chunk.
+// Loads must be from RAM/scratchpad or from status registers that don't
+// change anything when read; FIFO-style data registers are refused, since
+// a loop draining one would then take a chunk of time per byte.
+static int psx3d_idle_addr_ok(u_int a)
+{
+  a &= 0x1fffffff;
+  if (a < 0x00800000) return 1;                          // RAM + mirrors
+  if (a >= 0x1f800000 && a < 0x1f800400) return 1;       // scratchpad
+  if (a >= 0x1f801070 && a < 0x1f801078) return 1;       // I_STAT/I_MASK
+  if (a >= 0x1f801080 && a < 0x1f801100) return 1;       // DMA
+  if (a >= 0x1f801100 && a < 0x1f801130) return 1;       // timers
+  if (a >= 0x1f801044 && a < 0x1f801048) return 1;       // JOY_STAT
+  if (a == 0x1f801800) return 1;                         // CD status/index
+  if (a >= 0x1f801814 && a < 0x1f801818) return 1;       // GPUSTAT
+  if (a >= 0x1f801daa && a < 0x1f801db0) return 1;       // SPUCNT/SPUSTAT
+  return 0;
+}
+
+// value of reg r at instruction j, if built by lui (+ addiu/ori) in the
+// straight-line code just before it
+static int psx3d_reg_const_before(struct compile_state *st, int j, int r,
+  int stop, u_int *val)
+{
+  int k, have_lo = 0, lo_op = 0;
+  u_int lo = 0;
+  if (r == 0) { *val = 0; return 1; }
+  for (k = j - 1; k >= stop && k >= j - 16; k--) {
+    if (dops[k].is_jump)
+      return 0;
+    if (dops[k].rt1 != r && dops[k].rt2 != r) {
+      if (dops[k].bt) return 0;   // another path joins here
+      continue;
+    }
+    if (dops[k].itype == IMM16 && dops[k].opcode == 0x0f) { // lui
+      *val = (u_int)cinfo[k].imm << 16;
+      if (have_lo)
+        *val = lo_op == 0x0d ? (*val | lo) : (*val + lo);
+      return 1;
+    }
+    if (!have_lo && dops[k].itype == IMM16 && dops[k].rs1 == r &&
+        (dops[k].opcode == 0x09 || dops[k].opcode == 0x0d)) { // addiu/ori r, r
+      have_lo = 1;
+      lo_op = dops[k].opcode;
+      lo = (u_int)cinfo[k].imm;
+      if (dops[k].bt) return 0;
+      continue;
+    }
+    return 0;
+  }
+  return 0;
+}
+
+static noinline void pass1c_idle_loops(struct compile_state *st)
+{
+  int i, j, t;
+  for (i = 0; i < st->slen; i++)
+    dops[i].is_idle = 0;
+  if (!psx3d_idle_skip)
+    return;
+  for (i = 0; i < st->slen - 1; i++)
+  {
+    uint64_t written = 0, so_far = 0;
+    int last_load_rt = -1, ok = 1;
+    if (dops[i].itype != CJUMP && dops[i].itype != SJUMP)
+      continue;
+    if (dops[i].rt1 == 31)             // BLTZAL/BGEZAL
+      continue;
+    if (!internal_branch(st, cinfo[i].ba))
+      continue;
+    t = (cinfo[i].ba - st->start) >> 2;
+    if (t > i || i - t > 12 || dops[t].is_ds)
+      continue;
+    if (t == i && st->source[i+1] == 0)
+      continue;                        // the dynarec's own idle loop case
+    // nothing else may branch into the loop
+    for (j = 0; j < st->slen && ok; j++)
+      if (j != i && dops[j].is_jump && cinfo[j].ba >= st->start + t*4
+          && cinfo[j].ba <= st->start + (i+1)*4)
+        ok = 0;
+    // body t..i-1, the branch i, its delay slot i+1
+    for (j = t; j <= i + 1 && ok; j++) {
+      if (j == i)
+        ;
+      else switch (dops[j].itype) {
+        case NOP: case LOAD: case LOADLR: case ALU: case SHIFT:
+        case SHIFTIMM: case IMM16: case MOV:
+          break;
+        default:
+          ok = 0;
+      }
+      if (dops[j].rt1) written |= 1ull << dops[j].rt1;
+      if (dops[j].rt2) written |= 1ull << dops[j].rt2;
+    }
+    // anything read before it's written this time round comes from the
+    // previous iteration (a counter, a timeout): not idle
+    for (j = t; j <= i + 1 && ok; j++) {
+      int rs[2] = { dops[j].rs1, dops[j].rs2 }, n;
+      for (n = 0; n < 2; n++) {
+        int r = rs[n];
+        if (r <= 0)
+          continue;
+        if (((written >> r) & 1) && !((so_far >> r) & 1))
+          ok = 0;
+        if (r == last_load_rt)         // load delay slot: reads the old value
+          ok = 0;
+      }
+      last_load_rt = (dops[j].itype == LOAD || dops[j].itype == LOADLR) ? dops[j].rt1 : -1;
+      if (dops[j].rt1) so_far |= 1ull << dops[j].rt1;
+      if (dops[j].rt2) so_far |= 1ull << dops[j].rt2;
+    }
+    // what do the loads read? Unknown addresses are let through only for a
+    // loop with a single load: draining a FIFO takes a status read plus a
+    // data read, a plain wait on one register or variable takes one.
+    int nloads = 0;
+    for (j = t; j <= i + 1; j++)
+      if (dops[j].itype == LOAD || dops[j].itype == LOADLR)
+        nloads++;
+    for (j = t; j <= i + 1 && ok; j++) {
+      u_int base;
+      int r;
+      if (dops[j].itype != LOAD && dops[j].itype != LOADLR)
+        continue;
+      r = dops[j].rs1;
+      if (psx3d_reg_const_before(st, j, r, t, &base) ||
+          (!((written >> r) & 1) && psx3d_reg_const_before(st, t, r, 0, &base)))
+        ok = psx3d_idle_addr_ok(base + (u_int)cinfo[j].imm);
+      else if ((r == 28 || r == 29 || r == 30) && !((written >> r) & 1))
+        ok = 1;                        // gp/sp/fp: RAM
+      else
+        ok = nloads == 1;
+    }
+    if (!ok)
+      continue;
+    dops[i].is_idle = 1;
+    if (psx3d_idle_loops++ < 32)
+      SysPrintf("idle loop @%08x (%d insns)\n", st->start + t*4, i - t + 2);
+  }
+}
